# ===========================
# Application Settings
# ===========================
APP_NAME=Facial Recognition Attendance System
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ===========================
# Server
# ===========================
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================
# Database (PostgreSQL)
# ===========================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/face_attendance
DATABASE_ECHO=false

# ===========================
# Redis
# ===========================
REDIS_URL=redis://localhost:6379/0

# ===========================
# JWT Authentication
# ===========================
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# Face Recognition Pipeline
# ===========================
# Detection
FACE_DETECTION_CONFIDENCE=0.7
FACE_DETECTION_MODEL=mediapipe

# Quality Assessment
QUALITY_BLUR_THRESHOLD=100.0
QUALITY_MIN_FACE_SIZE=80
QUALITY_MAX_YAW=30.0
QUALITY_MAX_PITCH=20.0
QUALITY_MIN_SCORE=0.5

# Liveness Detection
LIVENESS_THRESHOLD=0.5
LIVENESS_MODEL_PATH=data/models/anti_spoof_models

# Face Recognition
RECOGNITION_MODEL=buffalo_l
RECOGNITION_THRESHOLD=0.4
EMBEDDING_DIMENSION=512

# ===========================
# File Storage
# ===========================
MODELS_DIR=data/models
FACES_DIR=data/faces
EXPORTS_DIR=data/exports

# ===========================
# Attendance Rules
# ===========================
ATTENDANCE_COOLDOWN_SECONDS=300
ATTENDANCE_SESSION_MAX_DURATION_HOURS=4

# ===========================
# Security
# ===========================
ENCRYPTION_KEY=change-this-to-a-32-byte-key-for-face-image-encryption
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
